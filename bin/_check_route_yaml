#!/usr/bin/env python3
"""Schema check for ~/.agents/route.yaml (skills-first v2). Exit 1 on any violation."""
import sys
from pathlib import Path
import yaml

HUB = Path.home() / ".agents"
route = yaml.safe_load((HUB / "route.yaml").read_text())
roles = {a["id"] for a in route.get("spawn_roles", [])}
errors = []

if not roles:
    errors.append("no spawn_roles registered")
for r in route.get("routes", []):
    tag = r.get("intent", "?")
    for key in ("description", "triggers", "dispatch"):
        if key not in r:
            errors.append(f"route {tag}: missing '{key}'")
    tr = r.get("triggers", {})
    if not tr.get("keywords") and not tr.get("phrases"):
        errors.append(f"route {tag}: no keywords and no phrases")
    d = r.get("dispatch", {})
    skill = d.get("skill")
    if not skill:
        errors.append(f"route {tag}: dispatch.skill missing")
    elif not (HUB / "skills" / skill / "SKILL.md").is_file():
        errors.append(f"route {tag}: skill '{skill}' has no SKILL.md on disk")
    spawn = d.get("spawn")
    if spawn and spawn not in roles:
        errors.append(f"route {tag}: spawn '{spawn}' not in spawn_roles")
    loads = {a["id"]: a.get("loads") for a in route.get("spawn_roles", [])}
    if spawn and skill and loads.get(spawn) and loads[spawn] != skill:
        errors.append(f"route {tag}: spawn '{spawn}' loads '{loads[spawn]}', not '{skill}'")
    if not isinstance(r.get("priority", 0), int):
        errors.append(f"route {tag}: priority must be int")

fd = route.get("fallback", {}).get("dispatch", {})
fskill = fd.get("skill")
if not fskill:
    errors.append("fallback: dispatch.skill missing")
elif not (HUB / "skills" / fskill / "SKILL.md").is_file():
    errors.append(f"fallback: skill '{fskill}' has no SKILL.md on disk")
fspawn = fd.get("spawn")
if fspawn and fspawn not in roles:
    errors.append(f"fallback: spawn '{fspawn}' not in spawn_roles")

for e in errors:
    print(e)
sys.exit(1 if errors else 0)
