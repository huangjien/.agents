#!/usr/bin/env bash
# ~/.agents/bin/laya-classify — classify a prompt into the hub's route.yaml
# intents using the local laya decision engine (daemon on 127.0.0.1:8019).
#
# Usage:
#   laya-classify "why is my build failing after the upgrade?"
#   laya-classify --difficulty "explain how torch dispatch works"
#   echo "prompt" | laya-classify
#
# Output: "<intent> <answer_confidence>", plus "LOW-CONFIDENCE" when < 0.5
# and "smalltalk" when the greeting/identity gate fires (noul >= 0.8).
# With --difficulty: appends the difficulty level (trivial|easy|moderate|hard)
# for model-tier picking per the route.yaml tier hints.
# Eval-tuned: hybrid at T=0.5 scores 70% vs 63% keyword-only
# (evals/routing/report.md, n=57).
#
# Exit codes: 0 ok · 1 daemon unreachable or laya error · 2 usage error

set -euo pipefail

URL="${LAYA_URL:-http://127.0.0.1:8019/v1/systemone}"
DIFF=0
if [[ "${1:-}" == "--difficulty" ]]; then DIFF=1; shift; fi

if [[ $# -ge 1 ]]; then
  MESSAGE="$*"
else
  MESSAGE="$(cat)"
fi
[[ -n "$MESSAGE" ]] || { echo "usage: laya-classify [--difficulty] <prompt>" >&2; exit 2; }

PAYLOAD=$(DIFF="$DIFF" python3 - "$MESSAGE" <<'PY'
import json, os, sys
questions = {
    "intent": {
      "type": "choice",
      "instructions": "What does the user want in `message`?",
      "criteria": {
        "laptop_administration": "manage or configure this laptop, its tools, or agent clients",
        "software_maintenance": "maintain packages, CLIs, runtimes, toolchains",
        "debugging": "something is broken, failing, or erroring",
        "implementation": "build, write, create, or modify code",
        "review": "audit or check code for quality or security",
        "architecture": "system design, planning, tech decisions",
        "testing": "write tests or improve coverage",
        "documentation": "write docs, READMEs, technical prose",
        "investigation": "research, explain, understand, look into"}},
    "smalltalk": {
      "type": "noul",
      "instructions": "Is `message` a greeting, identity question, or simple factoid?"}
}
if os.environ.get("DIFF") == "1":
    questions["difficulty"] = {
      "type": "score",
      "instructions": "How hard is `message` for a language model?",
      "criteria": [
        "trivial: a lookup or one-liner",
        "easy: short answer, no reasoning",
        "moderate: several steps",
        "hard: long multi-step reasoning or specialist knowledge"]}
print(json.dumps({"state": {"message": sys.argv[1]}, "questions": questions}))
PY
)


RESP=$(curl -sS -m 10 "$URL" -H 'Content-Type: application/json' -d "$PAYLOAD") || {
  echo "laya daemon unreachable at $URL" >&2; exit 1; }
RESP_DIFF="$DIFF" python3 - "$RESP" <<'PY'
import json, os, sys
try:
    a = json.loads(sys.argv[1])["answers"]
except Exception:
    print("laya error: " + sys.argv[1][:200], file=sys.stderr); sys.exit(1)
i, s = a["intent"], a["smalltalk"]
conf = i["answer_confidence"]
flags = ("LOW-CONFIDENCE" if conf < 0.5 else "") + (" smalltalk" if s["noul"] >= 0.8 else "")
extra = ""
if os.environ.get("RESP_DIFF") == "1" and "difficulty" in a:
    lv = a["difficulty"].get("score")
    LEVELS = ["trivial", "easy", "moderate", "hard"]
    extra = " " + (LEVELS[int(round(lv))] if isinstance(lv, (int, float))
                   and 0 <= lv < 4 else str(lv))
print(f'{i["choice"]} {conf:.3f} {flags}{extra}'.rstrip())
PY
