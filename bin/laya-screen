#!/usr/bin/env bash
# ~/.agents/bin/laya-screen — local privacy screen for a prompt.
# Detects credentials, secrets, and personal data BEFORE the prompt
# reaches a cloud LLM. Uses the local laya daemon. Zero tokens leave.
#
# Usage:
#   laya-screen "my API key is sk-..."
#   echo "prompt" | laya-screen
#
# Output: one line per risk, then "CLEAN" or "RISK". Exit 0 in both cases
# (informational gate). Exit 1 = daemon unreachable. Exit 2 = usage error.

set -euo pipefail

URL="${LAYA_URL:-http://127.0.0.1:8019/v1/systemone}"

if [[ $# -ge 1 ]]; then
  MESSAGE="$*"
else
  MESSAGE="$(cat)"
fi
[[ -n "$MESSAGE" ]] || { echo "usage: laya-screen <prompt>" >&2; exit 2; }

PAYLOAD=$(python3 - "$MESSAGE" <<'PY'
import json, sys
print(json.dumps({
  "state": {"message": sys.argv[1]},
  "questions": {
    "has_credentials": {
      "type": "noul",
      "instructions": "Does `message` contain an API key, token, password, or private key?"},
    "has_personal_data": {
      "type": "noul",
      "instructions": "Does `message` contain personal data such as an email, phone number, home address, or ID number?"},
    "has_internal_paths": {
      "type": "noul",
      "instructions": "Does `message` reveal internal system paths, hostnames, or internal URLs that should stay private?"}
  }}))
PY
)

RESP=$(curl -sS -m 10 "$URL" -H 'Content-Type: application/json' -d "$PAYLOAD") || {
  echo "laya daemon unreachable at $URL" >&2; exit 1; }

python3 - "$RESP" <<'PY'
import json, sys
try:
    a = json.loads(sys.argv[1])["answers"]
except Exception:
    print("laya error: " + sys.argv[1][:200], file=sys.stderr); sys.exit(1)
risk = False
for name, label in [("has_credentials", "CREDENTIALS"),
                    ("has_personal_data", "PERSONAL-DATA"),
                    ("has_internal_paths", "INTERNAL-PATHS")]:
    if a[name]["noul"] >= 0.5:
        print(f"RISK {label} (p={a[name]['noul']:.2f})")
        risk = True
print("CLEAN" if not risk else "RISK")
PY
